# Copy this file to "key.properties" (same folder) and fill in your real
# release keystore details. DO NOT commit the real key.properties or the
# .jks/.keystore file to source control — both are already gitignored.
#
# Generate a keystore (once) with:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyPassword=REPLACE_WITH_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
