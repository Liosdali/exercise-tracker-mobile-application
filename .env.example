# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com

# Your Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous public key (from Project Settings > API)
SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Redirect URL for OAuth authentication
# Default: com.mythosforgelabs.atlasworkout://login-callback
# SUPABASE_AUTH_REDIRECT_URL=com.mythosforgelabs.atlasworkout://login-callback
